{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
    }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=lifetracker;Username=postgres;Password=mysecretpassword;",
  },
  "APIs": {
    "Buienradar": "https://data.buienradar.nl/2.0/feed/json",
    "GarminConnect": "http://127.0.0.1:9002/garmin/",
    "ActivityWatch": {
      "BaseUrl": "http://127.0.0.1:5600/api/0/",
      "BucketID": "aw-watcher-window_X3D"
    }
  }
}
