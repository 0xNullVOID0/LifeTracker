{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5071" },
      "Esp32": { "Url": "http://0.0.0.0:5072" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lifetracker;Username=postgres;Password=mysecretpassword;",
    "LifeTrackerTestDB": "Host=localhost;Port=5432;Database=lifetracker_tests;Username=postgres;Password=mysecretpassword;"
  },
  "APIs": {
    "Buienradar": "https://data.buienradar.nl/2.0/feed/json",
    "ESP32RoomClimate": "http://localhost:5071/API/room-climate",
    "GarminConnect": "http://127.0.0.1:9002/garmin/",
    "ActivityWatch": {
      "BaseUrl": "http://127.0.0.1:5600/api/0/",
      "BucketID": "aw-watcher-window_X3D"
    }
  },
  "JWT": {
    "Key": "DefaultDemoPlaceholderSecretKeyForLifeTrackerJWT",
    "Issuer": "LifeTrackerAPI",
    "Audience": "LifeTrackerClient",
    "Password": "demo"
  },
  "ESP32": {
    "DeviceID": "ESP32RoomClimate",
    "APIkey": "2lXWMk1JQ3i9MbFhhHT2xJdNZwrt4sBe"
  }
